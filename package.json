{
  "name": "qr-code-generator",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run web#dev",
    "build": "vp run web#build",
    "preview": "vp run web#preview",
    "test": "vp run -r test",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7"
  },
  "packageManager": "bun@1.3.3"
}
